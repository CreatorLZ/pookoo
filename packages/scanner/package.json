{
  "name": "@pookoo/scanner",
  "version": "0.2.0",
  "private": false,
  "description": "Deterministic static analysis engine for environment variable discovery, AST parsing, knowledge graph construction, and configuration auditing.",
  "keywords": [
    "env",
    "environment-variables",
    "static-analysis",
    "ast",
    "configuration",
    "knowledge-graph",
    "scanner",
    "dotenv",
    "nextjs",
    "vite",
    "react",
    "nodejs",
    "typescript",
    "audit",
    "security"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "prepublishOnly": "pnpm clean && pnpm build",
    "dev": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@pookoo/shared": "workspace:*",
    "js-yaml": "^5.2.2",
    "picocolors": "^1.1.1",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "vitest": "^1.4.0"
  },
  "author": "CreatorLZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CreatorLZ/pookoo.git"
  }
}
