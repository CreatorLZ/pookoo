{
  "name": "pookoo",
  "version": "0.1.5",
  "private": false,
  "description": "Deterministic CLI to audit, document, and manage environment variables. Detects unused, undocumented, and misconfigured config vars across Next.js, Vite, React, and Node.js projects.",
  "keywords": [
    "env",
    "environment-variables",
    "dotenv",
    "configuration",
    "config",
    "cli",
    "audit",
    "security",
    "static-analysis",
    "nextjs",
    "vite",
    "react",
    "nodejs",
    "devtools",
    "developer-tools",
    "env-example",
    "config-docs",
    "monorepo",
    "dx"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pookoo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pookoo/scanner": "workspace:*",
    "@pookoo/shared": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "author": "CreatorLZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CreatorLZ/pookoo.git"
  }
}
